{
  "name": "new-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm run -r --filter \"./packages/*\" build",
    "dev": "pnpm run -r --parallel dev",
    "clean": "pnpm -r exec rm -rf dist",
    "test": "pnpm run -r --filter \"./packages/*\" test",
    "generate": "pnpm run --filter demo generate"
  },
  "packageManager": "pnpm@10.10.0"
}
