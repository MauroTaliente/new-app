{
  "name": "@react33/react-networking",
  "version": "0.0.1",
  "description": "HTTP helpers, useAsyncFetch (one in-flight request per instance), and event bus",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "keywords": [
    "react",
    "fetch",
    "http",
    "api",
    "cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/networking"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/networking#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "react-networking-generate": "./dist/bin/generate-apis.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/generate-react33-apis.d.ts",
      "import": "./dist/generate-react33-apis.js",
      "default": "./dist/generate-react33-apis.js"
    },
    "./generate-openapi": {
      "types": "./dist/generate-openapi-bundle.d.ts",
      "import": "./dist/generate-openapi-bundle.js",
      "default": "./dist/generate-openapi-bundle.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/fetch/fetch.client.tsx src/generate-react33-apis.ts src/generate-openapi-bundle.ts src/bin/generate-apis.ts --format esm --dts",
    "prepublishOnly": "pnpm build",
    "generate:apis": "node dist/bin/generate-apis.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@react33/react-helpers": "workspace:*",
    "ts-essentials": "^10.0.4",
    "use-memo-one": "^1.1.3",
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@vitest/coverage-v8": "3.2.4",
    "happy-dom": "^15.11.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  }
}
