{
  "name": "@lib/networking",
  "version": "0.0.1",
  "description": "HTTP helpers, useAsyncFetch (one in-flight request per instance), and event bus",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lib-networking-generate": "./dist/bin/generate-apis.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/generate-lib-apis.d.ts",
      "import": "./dist/generate-lib-apis.js",
      "default": "./dist/generate-lib-apis.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/fetch/fetch.client.tsx src/generate-lib-apis.ts src/bin/generate-apis.ts --format esm --dts",
    "generate:apis": "node dist/bin/generate-apis.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lib/helpers": "workspace:*",
    "ts-essentials": "^10.0.4",
    "use-memo-one": "^1.1.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "happy-dom": "^15.11.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
