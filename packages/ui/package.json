{
  "name": "@react33/react-ui",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "description": "Concrete input components and decorative UI built on @react33/react-form and @react33/react-ui-base. Includes shadcn-inspired Radix-wrapped components.",
  "keywords": [
    "react",
    "components",
    "ui",
    "radix",
    "shadcn",
    "input",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --external react-dom --external @react33/react-form --external @react33/react-ui-base --external @react33/react-styles --external @react33/react-helpers --external @react33/react-hooks --external @react33/react-context --external @react33/react-networking --external @tabler/icons-react --external motion --external @radix-ui/react-dialog --external @radix-ui/react-popover --external @radix-ui/react-tooltip --external @radix-ui/react-dropdown-menu --external @radix-ui/react-toast --external @radix-ui/react-tabs",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react33/react-context": "workspace:*",
    "@react33/react-form": "workspace:*",
    "@react33/react-helpers": "workspace:*",
    "@react33/react-hooks": "workspace:*",
    "@react33/react-networking": "workspace:*",
    "@react33/react-styles": "workspace:*",
    "@react33/react-ui-base": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tabler/icons-react": "^3.28.1",
    "motion": "^12.5.0",
    "ts-essentials": "^10.0.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19",
    "@vitest/coverage-v8": "3.2.4",
    "happy-dom": "^15.11.7",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
