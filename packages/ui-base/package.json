{
  "name": "@maurotaliente/react-ui-base",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "description": "Shared UI primitives (Button, Icon, Overlay) and agnostic Radix-wrapped building blocks used across @maurotaliente/react-form and @maurotaliente/react-ui.",
  "keywords": [
    "react",
    "ui",
    "primitives",
    "radix",
    "button",
    "icon",
    "overlay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/ui-base"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/ui-base#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --external react-dom --external @maurotaliente/react-styles --external @maurotaliente/react-helpers --external @tabler/icons-react --external motion --external @radix-ui/react-dialog --external @radix-ui/react-popover --external @radix-ui/react-tooltip",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@maurotaliente/react-helpers": "workspace:*",
    "@maurotaliente/react-styles": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tabler/icons-react": "^3.28.1",
    "motion": "^12.5.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
