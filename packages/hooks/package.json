{
  "name": "@maurotaliente/react-hooks",
  "version": "0.0.1",
  "description": "React hooks: timer, viewport, route query, media",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "keywords": ["react", "hooks", "viewport", "media", "timer"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/hooks"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/hooks#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next-route-query.d.ts",
      "import": "./dist/next-route-query.js",
      "default": "./dist/next-route-query.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/next-route-query.ts --format esm --dts --external react --external react-dom --external next",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@maurotaliente/react-helpers": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "happy-dom": "^15.11.7",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
