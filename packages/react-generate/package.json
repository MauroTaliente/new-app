{
  "name": "@react33/react-generate",
  "version": "0.0.9",
  "description": "Unified codegen: styles, networking, i18n, and theme runtime from react33.config.json",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "keywords": [
    "react",
    "cli",
    "codegen",
    "generator",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/react-generate"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/react-generate#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "react-generate": "./dist/bin/react-generate.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/bin/react-generate.ts --format esm --dts --outDir dist/bin",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@react33/react-i18n": "workspace:*",
    "@react33/react-networking": "workspace:*",
    "@react33/react-session": "workspace:*",
    "@react33/react-styles": "workspace:*",
    "@react33/react-theme": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "3.2.4",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
