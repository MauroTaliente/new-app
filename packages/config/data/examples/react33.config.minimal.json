{
  "$schema": "../../react33.config.schema.json",
  "react33Styles": {
    "cssDir": "./theme",
    "domainsOrder": ["tokens", "palette", "theme"],
    "stylesOutput": "./theme/styles.generated.ts"
  },
  "react33I18n": {
    "defaultLocale": "es",
    "locales": ["es", "en"],
    "localesDir": "./locales",
    "persistenceMode": "cookie"
  },
  "react33Theme": {
    "persistenceMode": "localStorage"
  },
  "react33Networking": {
    "registryOutput": "./api/apis.generated.ts",
    "hooksOutput": "./api/apis.client.generated.tsx",
    "apis": {
      "public": {
        "url": "https://api.example.com",
        "headers": { "Accept": "application/json" }
      }
    }
  }
}
