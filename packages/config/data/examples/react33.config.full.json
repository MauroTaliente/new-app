{
  "$schema": "../../react33.config.schema.json",
  "react33Styles": {
    "fromCss": "./theme",
    "domainsOrder": ["tokens", "palette", "theme"],
    "output": "./theme/styles.generated.ts",
    "banner": "// Generated by react33 — do not edit.",
    "verbose": false,
    "watch": false
  },
  "react33I18n": {
    "defaultLocale": "es",
    "locales": ["es", "en"],
    "localesDirectory": "./locales",
    "urlLocalePattern": "^/(es|en)(/|$)",
    "generatedTypesOutput": "./locales/locales.generated.ts",
    "cookieName": "locale",
    "localStorageKey": "locale",
    "persistenceMode": "cookie"
  },
  "react33Theme": {
    "cookieName": "app-theme",
    "localStorageKey": "app-theme",
    "persistenceMode": "localStorage",
    "cookiePath": "/",
    "cookieMaxAgeSeconds": 31536000,
    "cookieSameSite": "lax"
  },
  "react33Networking": {
    "output": "./api/apis.generated.ts",
    "hooksOutput": "./api/apis.client.generated.tsx",
    "apis": {
      "admin": {
        "url": "https://api.example.com",
        "headers": { "Accept": "application/json" },
        "cache": "no-store"
      }
    },
    "openApi": {
      "files": {
        "demo": {
          "input": "../fixtures/openapi-3.1-demo.yaml",
          "scope": "admin",
          "basePath": "/v1",
          "typesOutput": "./.codegen/demo.openapi.types.ts",
          "zodOutput": "./.codegen/demo.openapi.zod.ts",
          "sdkOutput": "./.codegen/demo.openapi.ts",
          "hooksOutput": "./.codegen/demo.openapi.client.tsx",
          "include": { "tags": ["trips", "auth"] },
          "operations": {
            "listTrips": { "fetchOnMount": true, "verbose": false },
            "login": { "fetchOnMount": false, "initData": false }
          },
          "defaults": { "fetchOnMount": false, "verbose": false }
        }
      }
    }
  }
}
