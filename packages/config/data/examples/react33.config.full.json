{
  "$schema": "../../react33.config.schema.json",
  "react33Styles": {
    "cssDir": "./theme",
    "domainsOrder": ["tokens", "palette", "theme"],
    "stylesOutput": "./theme/styles.generated.ts",
    "banner": "// Generated by react33 — do not edit.",
    "verbose": false,
    "watch": false
  },
  "react33I18n": {
    "defaultLocale": "es",
    "locales": ["es", "en"],
    "localesDir": "./locales",
    "urlLocalePattern": "^/(es|en)(/|$)",
    "typesOutput": "./locales/locales.generated.ts",
    "cookieName": "locale",
    "localStorageKey": "locale",
    "persistenceMode": "cookie"
  },
  "react33Theme": {
    "cookieName": "app-theme",
    "localStorageKey": "app-theme",
    "persistenceMode": "localStorage",
    "cookiePath": "/",
    "cookieMaxAgeSeconds": 31536000,
    "cookieSameSite": "lax"
  },
  "react33Session": {
    "runtimeOutput": "./api/session.runtime.generated.ts",
    "primarySession": "main",
    "sessions": {
      "main": {
        "strategy": "bearer",
        "runtimeModule": "./main.session.runtime",
        "bearer": {
          "storageKey": "app.session",
          "storage": "localStorage",
          "accessTokenSkewSec": 30,
          "headers": { "Authorization": "Bearer {token}" },
          "proactiveRefresh": true
        },
        "retry": {
          "statuses": { "401": 1 },
          "tokenExpiredCode": "TOKEN_EXPIRED"
        }
      },
      "partner": {
        "strategy": "external",
        "runtimeModule": "./partner.session.runtime"
      }
    }
  },
  "react33Networking": {
    "registryOutput": "./api/apis.generated.ts",
    "hooksOutput": "./api/apis.client.generated.tsx",
    "apis": {
      "admin": {
        "url": "https://api.example.com",
        "headers": { "Accept": "application/json" },
        "cache": "no-store",
        "session": "main"
      }
    },
    "openApi": {
      "files": {
        "demo": {
          "specSource": "../fixtures/openapi-3.1-demo.yaml",
          "scope": "admin",
          "basePath": "/v1",
          "typesOutput": "./.codegen/demo.openapi.types.ts",
          "zodOutput": "./.codegen/demo.openapi.zod.ts",
          "sdkOutput": "./.codegen/demo.openapi.ts",
          "hooksOutput": "./.codegen/demo.openapi.client.tsx",
          "include": { "tags": ["trips", "auth"] },
          "operations": {
            "listTrips": { "fetchOnMount": true, "verbose": false },
            "login": { "fetchOnMount": false, "initData": false }
          },
          "defaults": { "fetchOnMount": false, "verbose": false }
        }
      }
    }
  }
}
