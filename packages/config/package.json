{
  "name": "@react33/react-config",
  "version": "0.0.2",
  "description": "Shared react33.config.json JSON Schema, partial schemas, and cross-package reference assets for the @react33 ecosystem.",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "keywords": [
    "react",
    "config",
    "json-schema",
    "codegen",
    "react33"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./react33.config.schema.json": "./react33.config.schema.json",
    "./react33-i18n.config.schema.json": "./react33-i18n.config.schema.json"
  },
  "files": [
    "react33.config.schema.json",
    "react33-i18n.config.schema.json",
    "README.md",
    "README.en.md",
    "README.es.md"
  ],
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
