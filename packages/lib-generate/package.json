{
  "name": "@maurotaliente/react-generate",
  "version": "0.0.1",
  "description": "Unified codegen: react-styles-generate + react-networking-generate",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "keywords": ["react", "cli", "codegen", "generator", "tokens"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/lib-generate"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/lib-generate#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "react-generate": "./dist/bin/react-generate.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/bin/react-generate.ts --format esm --dts --outDir dist/bin",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@maurotaliente/react-networking": "workspace:*",
    "@maurotaliente/react-styles": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
