{
  "name": "@react33/react-i18n",
  "version": "0.0.1",
  "description": "Typed dictionaries, rich string interpolation (ct), browser locale resolution, optional Next.js adapters",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "keywords": ["react", "i18n", "icu", "intl", "next"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/i18n#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.client.d.ts",
      "import": "./dist/next.client.js",
      "default": "./dist/next.client.js"
    },
    "./next/server": {
      "types": "./dist/next-server.d.ts",
      "import": "./dist/next-server.js",
      "default": "./dist/next-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/next.client.tsx src/next-server.ts --format esm --dts --external react --external react-dom --external next --external server-only",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@react33/react-helpers": "workspace:*",
    "@react33/react-persistence": "workspace:*",
    "intl-messageformat": "^11.2.0",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@vitest/coverage-v8": "3.2.4",
    "happy-dom": "^15.11.7",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
