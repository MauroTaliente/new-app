{
  "name": "@react33/react-theme",
  "version": "0.0.4",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "description": "Theme runtime: provider, hooks and DOM sync for design-token themes.",
  "keywords": [
    "react",
    "theme",
    "tokens",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "react-theme-generate": "./dist/bin/generate-theme-runtime.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js",
      "default": "./dist/persistence.js"
    },
    "./generate": {
      "types": "./dist/generate-theme-runtime.d.ts",
      "import": "./dist/generate-theme-runtime.js",
      "default": "./dist/generate-theme-runtime.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/persistence.ts src/generate-theme-runtime.ts src/bin/generate-theme-runtime.ts --format esm --dts",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@react33/react-context": "workspace:*",
    "@react33/react-persistence": "workspace:*",
    "@react33/react-styles": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.4",
    "happy-dom": "^15.11.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
