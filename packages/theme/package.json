{
  "name": "@react33/react-theme",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "description": "Theme runtime: provider, hooks and DOM sync for design-token themes.",
  "keywords": ["react", "theme", "tokens", "design-system"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react33/react-context": "workspace:*",
    "@react33/react-styles": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^15.11.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
