{
  "name": "@react33/react-styles",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Mauro Taliente <mauro.taliente3@gmail.com>",
  "description": "Design tokens and buildStyles utility — CSS variables + Tailwind interop.",
  "keywords": [
    "react",
    "tokens",
    "design-system",
    "tailwind",
    "css-variables"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurotaliente/new-app.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/maurotaliente/new-app/tree/main/packages/styles#readme",
  "bugs": {
    "url": "https://github.com/maurotaliente/new-app/issues"
  },
  "sideEffects": [
    "*.css",
    "defaults/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "defaults",
    "react33-styles.config.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "react-styles-generate": "./dist/bin/generate-tokens.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js",
      "default": "./dist/generate.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/generate.ts src/bin/generate-tokens.ts --format esm --dts",
    "prepublishOnly": "pnpm build",
    "generate": "node dist/bin/generate-tokens.js",
    "generate:tokens": "node dist/bin/generate-tokens.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@react33/react-helpers": "workspace:*",
    "chokidar": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "postcss": "^8.5.8",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@vitest/coverage-v8": "3.2.4",
    "react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
