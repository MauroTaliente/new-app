{
  "react33Styles": {
    "cssDir": "./src/theme",
    "domainsOrder": ["tokens", "palette", "theme"],
    "stylesOutput": "./src/theme/styles.generated.ts"
  },
  "react33I18n": {
    "defaultLocale": "es",
    "locales": ["es", "en"],
    "localesDir": "./src/locales",
    "cookieName": "locale",
    "persistenceMode": "cookie",
    "typesOutput": "./src/lib/i18n/i18n.generated.ts",
    "runtimeOutput": "./src/lib/i18n/i18n.runtime.client.generated.ts",
    "runtimeMode": "spa"
  },
  "react33Theme": {
    "cookieName": "demo-theme",
    "persistenceMode": "cookie",
    "runtimeOutput": "./src/theme/theme.runtime.client.generated.ts",
    "stylesModule": "./styles.generated"
  },
  "react33Session": {
    "runtimeOutput": "./src/api/session.runtime.generated.ts",
    "primarySession": "main",
    "sessions": {
      "main": {
        "strategy": "bearer",
        "runtimeModule": "./main.session.runtime",
        "bearer": {
          "storageKey": "demo.app.session",
          "storage": "localStorage",
          "accessTokenSkewSec": 30,
          "headers": { "Authorization": "Bearer {token}" },
          "proactiveRefresh": true
        },
        "retry": {
          "statuses": { "401": 1 },
          "tokenExpiredCode": "TOKEN_EXPIRED"
        },
        "persistenceEnvKey": "REACT33_SESSION_STORAGE"
      },
      "partner": {
        "strategy": "external",
        "runtimeModule": "./partner.session.runtime"
      },
      "kiosk": {
        "strategy": "bearer-static",
        "runtimeModule": "./kiosk.session.runtime",
        "bearerStatic": {
          "storage": "sessionStorage",
          "storageKey": "demo.kiosk.token"
        }
      }
    }
  },
  "react33Networking": {
    "registryOutput": "./src/api/apis.generated.ts",
    "hooksOutput": "./src/api/apis.client.generated.tsx",
    "runtimeModule": "./session.runtime.generated",
    "apis": {
      "billing": { "url": "https://billing.example.com", "session": "main" },
      "reports": { "url": "https://reports.partner.example.com", "session": "partner" },
      "catalog": { "url": "https://catalog.example.com", "session": "kiosk" }
    },
    "openApi": {
      "files": {
        "pokemon": {
          "specSource": "./openapi/pokeapi.openapi.yaml",
          "scope": "pokemon",
          "basePath": "/api/v2",
          "client": {
            "headers": {
              "Accept": "application/json"
            },
            "cache": "no-store",
            "credentials": "omit"
          },
          "validate": {
            "params": true,
            "response": true,
            "mode": "log"
          },
          "typesOutput": "./src/api/pokemon.openapi.types.ts",
          "zodOutput": "./src/api/pokemon.openapi.zod.ts",
          "sdkOutput": "./src/api/pokemon.openapi.ts",
          "hooksOutput": "./src/api/pokemon.openapi.client.generated.ts",
          "include": {
            "operationIds": ["pokemon_list", "pokemon_retrieve"]
          },
          "initData": {
            "source": "./src/api/pokemon.init-data.ts",
            "generate": true
          },
          "operations": {
            "pokemon_list": {
              "fetchOnMount": true,
              "verbose": true,
              "initData": "emptyPokemonListData",
              "validate": true
            },
            "pokemon_retrieve": {
              "fetchOnMount": false,
              "verbose": true,
              "validate": { "params": true, "response": false }
            }
          },
          "defaults": {
            "fetchOnMount": false,
            "verbose": true
          }
        }
      }
    }
  }
}
